# Copy once:
#   cp .env.example .env
# Then set GROQ_API_KEY. Local ClickHouse + Langfuse values below match docker-compose defaults.

# =============================================================================
# Always required
# =============================================================================
GROQ_API_KEY=gsk-your-groq-key

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_SCHEMA_MODEL=llama-3.1-8b-instant
# GROQ_CRITIC_MODEL=llama-3.1-8b-instant
# REPORT_PORT=8787

# =============================================================================
# LOCAL DOCKER (default) — matches source_code/docker-compose.yml
# =============================================================================
# App ClickHouse (service: clickhouse, container: schema-kings-clickhouse)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=schema_kings
CLICKHOUSE_PASSWORD=schema_kings
CLICKHOUSE_DATABASE=schema_kings
CLICKHOUSE_DOCKER_CONTAINER=schema-kings-clickhouse

# Langfuse (profile: langfuse) — seeded via LANGFUSE_INIT_* in docker-compose
# Login UI: http://localhost:3000  →  local@schema-kings.dev / schemakingslocal
# After `docker compose --profile langfuse down -v`, recreate containers so init re-seeds.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=lf_pk_schema_kings_local
LANGFUSE_SECRET_KEY=lf_sk_schema_kings_local_secret
LANGFUSE_PROJECT_ID=schema-kings

# =============================================================================
# CLICKHOUSE CLOUD (demo / submission) — comment out LOCAL ClickHouse block above
# and use these instead. Langfuse can stay local Docker or switch to Langfuse Cloud.
# =============================================================================
# CLICKHOUSE_URL=https://YOUR_HOST.aws.clickhouse.cloud:8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-password
# CLICKHOUSE_DATABASE=atlys
# SETUP_SKIP_BASE_LOAD=1
# CLICKHOUSE_NATIVE_PORT=9440
# (unset CLICKHOUSE_DOCKER_CONTAINER for Cloud — load.sh uses clickhouse client)

# Langfuse Cloud (optional; otherwise keep local Docker Langfuse keys above)
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PROJECT_ID=...
