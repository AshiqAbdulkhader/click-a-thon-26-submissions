# Clickathon — environment template (safe to commit)
# Copy to .env and fill in secrets:
#   cp .env.example .env

# ============================================
# ClickHouse Cloud
# ============================================
CLICKHOUSE_HOST=your-service.region.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=default
# RCA engine / MCP reads analytical copies here
CLICKHOUSE_RCA_DATABASE=eda
CLICKHOUSE_ENDPOINT=https://your-service.region.aws.clickhouse.cloud:8443

CLICKHOUSE_CLOUD_API_KEY=
CLICKHOUSE_CLOUD_API_SECRET=
CLICKHOUSE_SERVICE_ID=

# ============================================
# ClickHouse MCP
# ============================================
CLICKHOUSE_MCP_AUTH_TOKEN=

# ============================================
# Langfuse Cloud
# ============================================
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ============================================
# LibreChat
# ============================================
LIBRECHAT_PORT=3080
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

LIBRECHAT_USER_EMAIL=admin@example.com
LIBRECHAT_USER_PASSWORD=
LIBRECHAT_USER_NAME=Admin

# ============================================
# Azure OpenAI (Foundry)
# ============================================
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_API_KEY=
OPENAI_BASE_URL=https://YOUR_RESOURCE.services.ai.azure.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided

# ============================================
# Metrics glossary — locked via Clickathon-RCA MCP
# (sidagarwal04/click-a-thon-2026 only; no general GitHub MCP / no PAT needed)
# https://github.com/sidagarwal04/click-a-thon-2026/blob/main/InMobi/metrics_glossary.md
# ============================================
ADMIN_PANEL_PORT=3081
ADMIN_PANEL_SESSION_SECRET=

# ============================================
# ClickStack / HyperDX
# ============================================
HDX_IMAGE_REPO=docker.hyperdx.io
CH_IMAGE_REPO=docker.clickhouse.com
IMAGE_NAME_DOCKERHUB=hyperdx/hyperdx
NEXT_OTEL_COLLECTOR_IMAGE_NAME_DOCKERHUB=clickhouse/clickstack-otel-collector
IMAGE_VERSION=2
HYPERDX_API_PORT=8002
HYPERDX_APP_PORT=8080
HYPERDX_APP_URL=http://localhost
HYPERDX_LOG_LEVEL=info
HYPERDX_OPAMP_PORT=4320
# Must match the HyperDX team apiKey (Team Settings). OTLP ingest requires
# header: authorization=<this value> (raw key, not Bearer).
HYPERDX_API_KEY=
HYPERDX_OTEL_EXPORTER_CLICKHOUSE_DATABASE=otel
USAGE_STATS_ENABLED=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=clickathon-rca
# Same value as HYPERDX_API_KEY (raw key, not Bearer)
OTEL_EXPORTER_OTLP_HEADERS=authorization=
