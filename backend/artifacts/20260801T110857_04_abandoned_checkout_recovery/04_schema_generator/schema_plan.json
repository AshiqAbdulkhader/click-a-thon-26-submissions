{
  "database": "silver",
  "table_name": "abandoned_checkout_recovery_events",
  "engine": "ReplacingMergeTree",
  "partition_by": "toYYYYMM(timestamp)",
  "order_by": [
    "event_name",
    "timestamp",
    "application_id",
    "user_id",
    "event_id"
  ],
  "ttl": "timestamp + INTERVAL 18 MONTH",
  "columns": [
    {
      "name": "job_id",
      "type": "String",
      "source_path": null,
      "reason": "Pipeline run identifier for replay and trace joins."
    },
    {
      "name": "event_name",
      "type": "LowCardinality(String)",
      "source_path": "event",
      "reason": "Common event discriminator for funnel and step analysis."
    },
    {
      "name": "event_id",
      "type": "String",
      "source_path": "id",
      "reason": "Raw event identifier used for dedupe and audit."
    },
    {
      "name": "timestamp",
      "type": "DateTime64(3)",
      "source_path": "timestamp",
      "reason": "Primary time dimension for partitions and sequence analysis."
    },
    {
      "name": "app_version",
      "type": "LowCardinality(String)",
      "source_path": "app_version",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "application_id",
      "type": "String",
      "source_path": "application_id",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "channel",
      "type": "Nullable(LowCardinality(String))",
      "source_path": "channel",
      "reason": "Feature-specific field inferred from raw events."
    },
    {
      "name": "city",
      "type": "LowCardinality(String)",
      "source_path": "city",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "client_lib",
      "type": "LowCardinality(String)",
      "source_path": "client_lib",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "destination",
      "type": "LowCardinality(String)",
      "source_path": "destination",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "device_type",
      "type": "LowCardinality(String)",
      "source_path": "device_type",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "drop_step",
      "type": "LowCardinality(String)",
      "source_path": "drop_step",
      "reason": "Feature-specific field inferred from raw events."
    },
    {
      "name": "geoip_country_code",
      "type": "LowCardinality(String)",
      "source_path": "geoip_country_code",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "hours_since_drop",
      "type": "Nullable(UInt8)",
      "source_path": "hours_since_drop",
      "reason": "Feature-specific field inferred from raw events."
    },
    {
      "name": "os",
      "type": "Nullable(LowCardinality(String))",
      "source_path": "os",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "user_id",
      "type": "String",
      "source_path": "user_id",
      "reason": "Atlys common envelope field."
    },
    {
      "name": "raw_json",
      "type": "String",
      "source_path": null,
      "reason": "Lossless raw payload for audit, replay, and schema evolution."
    },
    {
      "name": "ingested_at",
      "type": "DateTime DEFAULT now()",
      "source_path": null,
      "reason": "Operational ingest timestamp."
    }
  ]
}
